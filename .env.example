# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Leave as-is for local Docker Compose (see docker-compose.yml).
DATABASE_URL=postgresql://vortex:vortex@localhost:5432/vortex?schema=public

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the relay API + WebSocket feed listen on
PORT=4000

# ─── Stellar ─────────────────────────────────────────────────────────────────
# Network to operate against: testnet | futurenet | mainnet
STELLAR_NETWORK=testnet
# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_SIGNER_SECRET_KEY=

# Deployed contract IDs (leave blank until deployed)
SETTLEMENT_CONTRACT_ID=
SOLVER_REGISTRY_CONTRACT_ID=

# Secret key for the backend's own Soroban signer, used to submit on-chain
# writes (settlement, slashing). A Stellar secret seed: starts with "S",
# 56 base32 characters. Leave blank in development/test — no write path runs
# without it. REQUIRED in production (NODE_ENV=production), and validated
# against that format so it can never silently default to a placeholder.
#
# Local dev: generate a throwaway TESTNET-only keypair, do not reuse it
# anywhere real, and never commit a filled-in value:
#   npx @stellar/stellar-cli keys generate local-dev --network testnet
#   npx @stellar/stellar-cli keys show local-dev
# or, ad hoc, via the SDK:
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
# Fund it on testnet with Friendbot before use:
#   curl "https://friendbot.stellar.org/?addr=<PUBLIC_KEY_FROM_ABOVE>"
SOROBAN_SIGNING_KEY=

# ─── Solver bot (scripts/solver-bot.ts) ─────────────────────────────────────
# Secret key for the reference solver bot — used to sign WS auth messages and
# REST request bodies (accept / fill). A Stellar secret seed (starts with "S").
# If unset, the bot runs in anonymous read-only mode (issue #121).
SOLVER_SECRET=
SOLVER_ADDRESS=
SOLVER_CHAINS=stellar,ethereum,base,polygon,arbitrum,optimism,avalanche

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
# Development default: "*"  (any origin allowed — convenient for local work)
# Production REQUIRED: must be an explicit origin, never "*"
#   e.g. CORS_ORIGIN=https://app.vortex.trade
# The app will refuse to start in production if this is "*" or unset.
CORS_ORIGIN=*

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Maximum number of concurrent WebSocket connections accepted by the gateway.
# Connections beyond this limit are rejected with close code 1013 (try again later).
# Set to 0 to disable the cap (not recommended in production).
WS_MAX_CONNECTIONS=1000

# Optional backplane for multi-instance fan-out. Default is "memory".
# Set to "redis" to publish WS events through Redis pub/sub and maintain a
# globally-shared seq counter for replay semantics.
WS_BACKPLANE=memory
REDIS_URL=redis://localhost:6379

# ─── Resource-exhaustion limits (issue #476) ─────────────────────────────────
# Maximum JSON nesting depth accepted before the body is rejected with 400.
# Rejects stack-exhaustion attacks that craft deeply-nested payloads.
# Default: 10 (all real DTOs are flat or two levels deep; 10 gives ×3 margin).
JSON_MAX_DEPTH=10

# Maximum chain-filter values allowed in a single WS subscribe message.
# Default: 20 (2× the number of supported chains — generous for multi-chain bots).
WS_MAX_FILTER_CHAINS=20

# Maximum active subscriptions a single WS connection may hold.
# Default: 10
WS_MAX_SUBSCRIPTIONS=10

# Postgres statement_timeout (milliseconds) for standard route queries.
# Default: 5000 (5 s)
DB_QUERY_TIMEOUT_MS=5000

# Postgres statement_timeout (milliseconds) for batch-lookup queries.
# Default: 10000 (10 s)
DB_BATCH_QUERY_TIMEOUT_MS=10000

# Postgres statement_timeout (milliseconds) for stats/aggregate queries.
# Default: 15000 (15 s)
DB_STATS_QUERY_TIMEOUT_MS=15000

# Emergency kill-switch (issue #477)
# ---------------------------------
# Shared secret for the operator control plane at /api/v1/ops/killswitch.
# Leave empty to DISABLE those routes entirely (fail closed, never open).
# Required in production.
KILLSWITCH_OPERATOR_TOKEN=

# Redis URL for cross-replica pause propagation. Leave empty to rely on the
# database poll only, which still meets the 5 s budget. Defaults to REDIS_URL
# when WS_BACKPLANE=redis.
KILLSWITCH_REDIS_URL=

# Database change-probe interval (ms) that backstops Redis pub/sub.
# Worst-case propagation delay is roughly this value. 100-5000, default 2000.
KILLSWITCH_POLL_MS=2000

# Persistence backend for kill-switch state.
#   memory (default) - in-process, resets on restart. Dev/test only.
#   prisma           - Postgres, survives restarts. Required for a real
#                      multi-replica deployment.
KILLSWITCH_PERSISTENCE=memory

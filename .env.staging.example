# .env.staging.example
#
# Staging environment configuration for the Vortex backend.
# It reuses the testnet-safe settings from .env.testnet.example and is intended
# to be used for pre-production validation before a manual production promotion.
#
# Copy this to .env when deploying to staging.

DATABASE_URL=postgresql://vortex:vortex@postgres:5432/vortex?schema=public
PORT=4000
NODE_ENV=staging

STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SETTLEMENT_CONTRACT_ID=
SOLVER_REGISTRY_CONTRACT_ID=
SOROBAN_SIGNING_KEY=
SOROBAN_FEE_PERCENTILE=p50

CORS_ORIGIN=*
WS_MAX_CONNECTIONS=1000
JSON_MAX_DEPTH=10
WS_MAX_FILTER_CHAINS=20
WS_MAX_SUBSCRIPTIONS=10
DB_QUERY_TIMEOUT_MS=5000
DB_BATCH_QUERY_TIMEOUT_MS=10000
DB_STATS_QUERY_TIMEOUT_MS=15000

# Emergency kill-switch (issue #477)
KILLSWITCH_OPERATOR_TOKEN=
KILLSWITCH_REDIS_URL=
KILLSWITCH_POLL_MS=2000
KILLSWITCH_PERSISTENCE=prisma
SENTRY_DSN=
LOG_LEVEL=debug
